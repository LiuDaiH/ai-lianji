/* components/intro/intro.wxss */
/* ⚠️ 注意：自定义组件默认样式隔离（isolated），app.wxss 里的 .btn-primary / .hover-dim
   在组件内部【不生效】。所以组件里用到的全局 class 必须在这里重新写全，
   否则会出现"按钮没内边距、文字不居中、颜色不对"的问题。 */

.intro-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1100;
  display: flex; flex-direction: column;
  /* 兜底底色 —— 万一背景层没渲染出来，也不该看到后面的页面 */
  background: #1F3FB8;
  animation: imIn .26s ease both;
}
@keyframes imIn { from { opacity: 0 } to { opacity: 1 } }
/* 背景：5 层叠在一起，只有当前屏那层 .on 是 opacity 1 —— 切屏时真正交叉淡入。
   （旧版写法是每层写死 opacity，结果只有 bg0 能看见，切换背景其实没变。） */
.intro-bg {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  opacity: 0;
  transition: opacity .6s ease;
}
.intro-bg.on { opacity: 1; }
.intro-bg.bg0 { background: linear-gradient(160deg, #1F3FB8 0%, #3B6FF5 60%, #6C8FF7 100%); }
.intro-bg.bg1 { background: linear-gradient(160deg, #1A1146 0%, #4A32C8 52%, #7C5BD9 100%); }
.intro-bg.bg2 { background: linear-gradient(160deg, #4A2E9E 0%, #7C5BD9 60%, #A18BF0 100%); }
.intro-bg.bg3 { background: linear-gradient(160deg, #1D5E7A 0%, #2E8FB8 60%, #6BC3E0 100%); }
.intro-bg.bg4 { background: linear-gradient(160deg, #0F5C43 0%, #22B573 60%, #6BD8A8 100%); }
.intro-bg.bg5 { background: linear-gradient(160deg, #2B1E63 0%, #5B4BD9 55%, #7C9BFF 100%); }
.intro-bg.bg-glow {
  background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.22) 0%, rgba(255,255,255,0) 60%);
  opacity: 1;
  animation: glowMove 7s ease-in-out infinite alternate;
}
@keyframes glowMove {
  from { transform: translate(-4%, -4%) scale(1); }
  to   { transform: translate(6%, 5%) scale(1.15); }
}

.intro-top {
  position: relative; display: flex; align-items: center; justify-content: space-between;
  padding: 90rpx 48rpx 0;
}
.intro-brand { display: flex; align-items: center; }
.ib-logo {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .28);
}
.ib-name {
  font-size: 30rpx; font-weight: 800; color: #FFF;
  letter-spacing: 3rpx; margin-left: 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .25);
}
.intro-skip { display: inline-block; font-size: 26rpx; color: rgba(255,255,255,.72); padding: 8rpx 20rpx; }

.intro-body { position: relative; flex: 1; display: flex; align-items: center; }
.swiper { width: 100%; height: 720rpx; }
swiper-item { display: flex; flex-direction: column; align-items: center; }

.s-stage { height: 290rpx; width: 100%; display: flex; flex-direction: column;
  align-items: center; justify-content: center; }

.s-text { padding: 0 56rpx; text-align: center; }
/* 当前屏的文案做错峰入场（切屏时重新触发） */
.s-text.anim .s-tag   { animation: slideUp .42s cubic-bezier(.2,.9,.3,1.1) both; }
.s-text.anim .s-title { animation: slideUp .46s cubic-bezier(.2,.9,.3,1.1) .06s both; }
.s-text.anim .s-desc  { animation: slideUp .5s  cubic-bezier(.2,.9,.3,1.1) .13s both; }
@keyframes slideUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.s-tag { display: inline-block; background: rgba(255,255,255,.2); color: #FFF;
  font-size: 21rpx; padding: 4rpx 18rpx; border-radius: 18rpx; margin-bottom: 16rpx; }
.s-title { font-size: 40rpx; font-weight: 700; color: #FFF; line-height: 1.35; }
.s-desc { font-size: 26rpx; color: rgba(255,255,255,.86); line-height: 1.72; margin-top: 14rpx; }

/* 场景 1 */
.stack { position: relative; width: 300rpx; height: 190rpx; }
.sc { position: absolute; left: 50%; width: 260rpx; height: 140rpx;
  background: rgba(255,255,255,.95); border-radius: 18rpx; transform: translateX(-50%);
  box-shadow: 0 8rpx 22rpx rgba(18,22,32,.18); }
.sc3 { top: 40rpx; opacity: .45; animation: upIn .5s ease .05s both; }
.sc2 { top: 20rpx; opacity: .72; animation: upIn .5s ease .16s both; }
.sc1 { top: 0; animation: upIn .55s cubic-bezier(.2,.9,.3,1.3) .28s both; }
.sc-line { height: 14rpx; border-radius: 7rpx; background: #DDE6FA; margin: 22rpx 0 0 24rpx; }
.w70 { width: 150rpx; } .w45 { width: 96rpx; background: #C4D4F5; }
@keyframes upIn { from { opacity: 0; transform: translateX(-50%) translateY(28rpx) } to { opacity: 1 } }

/* 场景 2 */
.fake-input { width: 320rpx; padding: 16rpx 22rpx; background: rgba(255,255,255,.92);
  border-radius: 14rpx; font-size: 22rpx; color: #6B7280; line-height: 1.75;
  animation: upIn2 .4s ease both; }
@keyframes upIn2 { from { opacity: 0; transform: translateY(20rpx) } to { opacity: 1 } }
.down-arrow { font-size: 30rpx; color: #FFF; margin: 8rpx 0; animation: bounceA 1s ease-in-out infinite; }
@keyframes bounceA { 0%,100% { transform: translateY(0) } 50% { transform: translateY(7rpx) } }
.tiny-row { display: flex; gap: 12rpx; }
.tiny { padding: 10rpx 18rpx; background: rgba(255,255,255,.95); color: #3B6FF5;
  border-radius: 12rpx; font-size: 22rpx; font-weight: 600;
  animation: popIn .42s cubic-bezier(.2,.9,.3,1.4) both; }
.t1 { animation-delay: .06s } .t2 { animation-delay: .24s } .t3 { animation-delay: .42s }
@keyframes popIn { from { opacity: 0; transform: scale(.7) } to { opacity: 1; transform: scale(1) } }

/* 场景 3 */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; padding: 0 60rpx; }
.chip { padding: 14rpx 28rpx; border-radius: 30rpx; font-size: 26rpx; font-weight: 600;
  background: rgba(255,255,255,.95); color: #3B6FF5;
  animation: popIn .42s cubic-bezier(.2,.9,.3,1.4) both; }
.c1 { animation-delay: .05s } .c2 { animation-delay: .17s } .c3 { animation-delay: .29s }
.c4 { animation-delay: .41s } .c5 { animation-delay: .53s }

/* 场景 4：间隔增长的柱条 */
.bars4 { display: flex; align-items: flex-end; gap: 18rpx; height: 190rpx; }
.b4 { width: 70rpx; border-radius: 12rpx 12rpx 0 0; background: rgba(255,255,255,.95);
  color: #3B6FF5; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: flex-end; justify-content: center; padding-bottom: 8rpx;
  transform-origin: bottom; animation: growUp .6s cubic-bezier(.2,.9,.3,1) both; }
.b41 { height: 30%; animation-delay: .05s }
.b42 { height: 50%; animation-delay: .25s }
.b43 { height: 72%; animation-delay: .45s }
.b44 { height: 100%; animation-delay: .65s }
@keyframes growUp { from { transform: scaleY(0); opacity: 0 } to { transform: scaleY(1); opacity: 1 } }

/* 场景 5 */
.heat-demo { display: flex; flex-wrap: wrap; width: 340rpx; gap: 6rpx; justify-content: center; }
.hc { width: 24rpx; height: 24rpx; border-radius: 6rpx; animation: popIn .3s ease both; }
.hc.lv0 { background: rgba(255,255,255,.2) }
.hc.lv1 { background: rgba(255,255,255,.45) }
.hc.lv2 { background: rgba(255,255,255,.72) }
.hc.lv3 { background: #FFF }

/* ---------- 第 2 屏：Obsidian 双向同步（核心创新点） ---------- */
.s-tag.hot {
  background: linear-gradient(135deg, #FFE9A8, #F5C24B);
  color: #5A3E00; font-weight: 700; letter-spacing: .5rpx;
  box-shadow: 0 6rpx 18rpx rgba(245,194,75,.4);
}

.ob-loop { display: flex; align-items: center; gap: 10rpx; animation: upIn2 .45s ease both; }
.ob-box {
  width: 138rpx; padding: 18rpx 8rpx; text-align: center;
  background: rgba(255,255,255,.14); border: 2rpx solid rgba(255,255,255,.26);
  border-radius: 20rpx;
}
.ob-box.hot {
  background: rgba(108,143,247,.34); border-color: rgba(160,190,255,.62);
  box-shadow: 0 8rpx 22rpx rgba(59,111,245,.4);
}
.ob-ico { font-size: 40rpx; line-height: 1.1; }
.ob-name { font-size: 21rpx; color: #FFF; margin-top: 6rpx; opacity: .92; }

.ob-arrows { width: 150rpx; flex-shrink: 0; }
.ob-a {
  position: relative; height: 32rpx; display: flex; align-items: center;
  font-size: 19rpx; color: rgba(255,255,255,.9);
}
.ob-a::before {
  content: ""; position: absolute; left: 0; right: 16rpx; top: 50%;
  height: 3rpx; border-radius: 2rpx;
}
.ob-a::after {
  content: ""; position: absolute; right: 0; top: 50%; margin-top: -7rpx;
  border-left: 14rpx solid currentColor;
  border-top: 7rpx solid transparent; border-bottom: 7rpx solid transparent;
}
.ob-a.fwd { color: #FFE9A8; }
.ob-a.fwd::before { background: linear-gradient(90deg, rgba(255,233,168,.2), #FFE9A8); }
.ob-a.back { color: #9DBBFF; justify-content: flex-end; }
.ob-a.back::before { background: linear-gradient(90deg, #9DBBFF, rgba(157,187,255,.2)); }
.ob-a.back::after { right: auto; left: 0; border-left: 0;
  border-right: 14rpx solid currentColor; }
.ob-a text { position: relative; z-index: 1; background: rgba(22,27,46,.9);
  padding: 0 8rpx; border-radius: 6rpx; }
.ob-a.fwd text { margin-left: 12rpx; }
.ob-a.back text { margin-right: 12rpx; }

.ob-demo {
  margin-top: 22rpx; background: rgba(10,14,24,.72); border-radius: 14rpx;
  padding: 16rpx 20rpx; font-family: ui-monospace, Menlo, Consolas, monospace;
  animation: upIn2 .5s ease .12s both;
}
.od-h { font-size: 21rpx; color: #C7CEDB; }
.od-c { font-size: 21rpx; color: #8CE0B4; margin-top: 6rpx; }
.od-tag { color: #6C8FF7; }

/* ---------- 第 5 屏：发散图 + 掌握度 ---------- */
.mrad { position: relative; width: 300rpx; height: 300rpx; }
.mr-core {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
  width: 76rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 50%; background: #FFF; color: #3B6FF5;
  font-size: 21rpx; font-weight: 700;
  box-shadow: 0 0 0 8rpx rgba(255,255,255,.18), 0 6rpx 20rpx rgba(15,30,80,.28);
}
.mr-ring { position: absolute; }
.mr-ring.r1 { left: 26%; top: 26%; right: 26%; bottom: 26%; }
.mr-ring.r2 { left: 0; top: 0; right: 0; bottom: 0; }
.mr-n {
  position: absolute; width: 18rpx; height: 18rpx; border-radius: 50%;
  transform: translate(-50%,-50%);
  animation: popIn .45s cubic-bezier(.2,.9,.3,1.4) both;
}
.mr-n.g { background: #4FE0A8; box-shadow: 0 0 0 6rpx rgba(79,224,168,.20); }
.mr-n.b { background: #8FB0FF; box-shadow: 0 0 0 6rpx rgba(143,176,255,.20); }
.mr-n.o { background: #F5C24B; box-shadow: 0 0 0 6rpx rgba(245,194,75,.20); }

.mr-ring.r1 .mr-n:nth-child(1) { left: 50%; top: 0;   animation-delay: .10s }
.mr-ring.r1 .mr-n:nth-child(2) { left: 100%; top: 50%; animation-delay: .18s }
.mr-ring.r1 .mr-n:nth-child(3) { left: 50%; top: 100%; animation-delay: .26s }
.mr-ring.r1 .mr-n:nth-child(4) { left: 0;   top: 50%; animation-delay: .34s }

.mr-ring.r2 .mr-n:nth-child(1) { left: 50%; top: 0;   animation-delay: .06s }
.mr-ring.r2 .mr-n:nth-child(2) { left: 93%; top: 25%; animation-delay: .12s }
.mr-ring.r2 .mr-n:nth-child(3) { left: 93%; top: 75%; animation-delay: .18s }
.mr-ring.r2 .mr-n:nth-child(4) { left: 50%; top: 100%; animation-delay: .24s }
.mr-ring.r2 .mr-n:nth-child(5) { left: 7%;  top: 75%; animation-delay: .30s }
.mr-ring.r2 .mr-n:nth-child(6) { left: 7%;  top: 25%; animation-delay: .36s }

/* ---------- 底部 ---------- */
.intro-foot { position: relative; padding: 0 56rpx 70rpx; }
.dots { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 26rpx; }
.dots .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: rgba(255,255,255,.4); transition: all .25s;
}
.dots .dot.on { width: 30rpx; border-radius: 7rpx; background: #FFF; }

/* 「每次打开都显示」勾选 */
.always-row {
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
}
.always-chk {
  width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  border-radius: 8rpx; border: 2rpx solid rgba(255,255,255,.5);
  font-size: 20rpx; color: #FFF; margin-right: 12rpx; flex-shrink: 0;
  transition: all .16s ease;
}
.always-row.on .always-chk { background: #FFF; border-color: #FFF; color: #3B6FF5; font-weight: 700; }
.always-txt { font-size: 23rpx; color: rgba(255,255,255,.78); }

/* 主按钮 —— 这里必须写全，不能依赖 app.wxss 的 .btn-primary */
.intro-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  background: #FFFFFF;
  color: #3B6FF5;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 26rpx rgba(15,30,80,.22);
  transition: opacity .12s, transform .12s;
}

/* 组件内部的点按反馈（app.wxss 里的 .hover-dim 同样不生效） */
.hover-dim { opacity: .74; transform: scale(.985); }

/* ==================== 核心创新点 ①：AI 学习引擎 ==================== */
.ai-flow {
  display: flex; align-items: center; gap: 8rpx;
  animation: upIn2 .45s ease both;
}
.aif-box {
  padding: 16rpx 14rpx; border-radius: 14rpx; font-size: 21rpx; text-align: center;
  line-height: 1.35;
}
.aif-box.mess {
  background: rgba(255,255,255,.14); border: 2rpx dashed rgba(255,255,255,.42);
  color: rgba(255,255,255,.78);
}
.aif-box.clean {
  background: #FFF; color: #4A32C8; font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,.22);
}
.aif-arrow { font-size: 34rpx; color: rgba(255,255,255,.6); flex-shrink: 0; }
.aif-core {
  width: 106rpx; height: 106rpx; line-height: 106rpx; text-align: center;
  border-radius: 50%; flex-shrink: 0;
  background: #FFF; color: #4A32C8;
  font-size: 32rpx; font-weight: 800; letter-spacing: 1rpx;
  box-shadow: 0 0 0 12rpx rgba(255,255,255,.16), 0 10rpx 26rpx rgba(0,0,0,.26);
  animation: aiCore 1.8s ease-in-out infinite;
}
@keyframes aiCore {
  0%,100% { box-shadow: 0 0 0 12rpx rgba(255,255,255,.16), 0 10rpx 26rpx rgba(0,0,0,.26); }
  50%     { box-shadow: 0 0 0 22rpx rgba(255,255,255,.06), 0 10rpx 26rpx rgba(0,0,0,.26); }
}

.ai-chips {
  display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center;
  margin-top: 26rpx; padding: 0 30rpx;
}
.ai-chip {
  padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  background: rgba(255,255,255,.16); border: 2rpx solid rgba(255,255,255,.30);
  color: #FFF;
  animation: popIn .42s cubic-bezier(.2,.9,.3,1.4) both;
}
.ai-chip:nth-child(1) { animation-delay: .06s }
.ai-chip:nth-child(2) { animation-delay: .15s }
.ai-chip:nth-child(3) { animation-delay: .24s }
.ai-chip:nth-child(4) { animation-delay: .33s }
.ai-chip:nth-child(5) { animation-delay: .42s }

.ai-boundary {
  margin-top: 20rpx; font-size: 21rpx; color: rgba(255,255,255,.72);
  letter-spacing: .5rpx;
}

/* 非 AI 版圆圈里是「自动」两个字，字号调小、去掉字间距 */
.aif-core.two { font-size: 26rpx; letter-spacing: 0; font-weight: 700; }
