/* ===== 本页主题色（覆盖 app.wxss 默认值） ===== */
page {
  --brand: #3B6FF5;
  --brand-2: #6C8FF7;
  --brand-soft: #EDF2FF;
  --brand-ghost: rgba(59, 111, 245, .10);
  --brand-glow: rgba(59, 111, 245, .28);
  --bg-1: #F4F7FF;
  --bg-2: #ECF0FA;
  --card-2: #FCFDFF;
}

/* pages/index/index.wxss */
/* ---------- 品牌条 ---------- */
.brand {
  display: flex; align-items: center;
  padding: 2rpx 8rpx 20rpx;
}
.brand-logo {
  width: 84rpx; height: 84rpx; border-radius: 22rpx; flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx var(--brand-glow);
}
.brand-text { margin-left: 20rpx; min-width: 0; }
.brand-name {
  font-size: 40rpx; font-weight: 800; line-height: 1.2; letter-spacing: 2rpx;
  background-image: linear-gradient(120deg, var(--brand), var(--brand-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.brand-tag {
  font-size: 22rpx; color: #8A90A0; margin-top: 6rpx; line-height: 1.4;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

.cat-bar {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FFFFFF 0%, var(--brand-soft) 100%);
  border-radius: 999rpx; padding: 18rpx 22rpx 18rpx 26rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(31,36,48,.06);
}
.cat-bar-label { font-size: 23rpx; color: #9AA0AC; margin-right: 14rpx; }
.cat-bar-value { flex: 1; font-size: 29rpx; font-weight: 600; color: var(--brand);
                 overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cat-bar-go { font-size: 25rpx; color: var(--brand); flex-shrink: 0; }
.help-btn {
  width: 46rpx; height: 46rpx; line-height: 46rpx; text-align: center;
  border-radius: 50%; background: var(--brand-soft); color: var(--brand);
  font-size: 26rpx; font-weight: 700; margin-left: 14rpx; flex-shrink: 0;
}

/* ---------- 一键开始 ---------- */
.start-card {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  border-radius: 30rpx; padding: 38rpx 34rpx 32rpx; color: #FFF;
  margin-bottom: 22rpx;
  box-shadow: 0 12rpx 32rpx var(--brand-glow);
  animation: fadeUp .36s cubic-bezier(.2,.9,.3,1.1) both;
}
/* 右上角柔和光斑，让纯色渐变不那么"平" */
.start-card::after {
  content: ""; position: absolute; right: -90rpx; top: -110rpx;
  width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.30), rgba(255,255,255,0) 70%);
}
/* 连续记录快断了 —— 换成暖色，视觉上更"催" */
.start-card.urge {
  background: linear-gradient(135deg, #F0851F 0%, #F5A94B 100%);
  box-shadow: 0 12rpx 32rpx rgba(240,133,31,.28);
}
.sc-title { font-size: 40rpx; font-weight: 700; line-height: 1.35; }
.sc-sub { font-size: 24rpx; opacity: .86; margin-top: 10rpx; line-height: 1.6; }

/* 今日目标进度 */
.sc-goal { margin-top: 26rpx; position: relative; z-index: 1; }
.sc-goal-top { display: flex; align-items: baseline; justify-content: space-between; }
.sc-goal-label { font-size: 24rpx; font-weight: 600; letter-spacing: .4rpx; }
.sc-goal-tail { font-size: 22rpx; opacity: .88; }
.sc-goal-tail.done { font-weight: 700; opacity: 1; }
.sc-track {
  height: 16rpx; border-radius: 999rpx; margin-top: 12rpx;
  background: rgba(255,255,255,.28); overflow: hidden;
}
.sc-track-fill {
  height: 100%; border-radius: 999rpx;
  background: #FFF;
  box-shadow: 0 0 14rpx rgba(255,255,255,.6);
  transition: width .6s cubic-bezier(.2,.9,.3,1);
  animation: grow .7s cubic-bezier(.2,.9,.3,1) both; transform-origin: left center;
}
.sc-track-fill.is-ok { background: linear-gradient(90deg, #FFF, #D6FFEC); }

.sc-urge {
  margin-top: 18rpx; padding: 14rpx 20rpx;
  background: rgba(255,255,255,.2); border-radius: 12rpx;
  font-size: 24rpx; line-height: 1.6;
}
.sc-btn {
  display: inline-block; margin-top: 24rpx; position: relative; z-index: 1;
  background: #FFF; color: var(--brand);
  font-size: 28rpx; font-weight: 700;
  padding: 16rpx 40rpx; border-radius: 40rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.10);
}
.start-card.urge .sc-btn { color: #D9741A; }

/* ---------- 概览 ---------- */
.brief { padding: 26rpx 28rpx; }
.brief-row { display: flex; align-items: center; }
.brief-item { display: flex; align-items: baseline; }
.brief-num { font-size: 46rpx; font-weight: 800; color: var(--brand); margin-right: 8rpx;
             font-variant-numeric: tabular-nums; }
.brief-num.hot { color: #F0851F; }
.brief-sep { width: 1rpx; height: 40rpx; background: #E7EBF3; margin: 0 30rpx; }

.stack { display: flex; height: 22rpx; border-radius: 11rpx; overflow: hidden; background: #EEF0F6; margin-top: 22rpx; }
.seg { height: 100%; }
.seg-new { background: #C7CEDB; }
.seg-learn { background: linear-gradient(180deg, #6C8FF7, #3B6FF5); }
.seg-master { background: linear-gradient(180deg, #4FD1A5, #22B573); }
.legend { display: flex; gap: 20rpx; margin-top: 16rpx; flex-wrap: wrap; }
.lg { display: flex; align-items: center; font-size: 23rpx; color: #6B7280; }
.dot { width: 13rpx; height: 13rpx; border-radius: 50%; margin-right: 7rpx; }
.d-new { background: #C7CEDB; }
.d-learn { background: #3B6FF5; }
.d-master { background: #22B573; }

.onboard { text-align: center; padding: 70rpx 40rpx 40rpx; }
.ob-emoji { font-size: 90rpx; line-height: 1; }
.ob-title { font-size: 34rpx; font-weight: 700; margin-top: 24rpx; }
.ob-step { font-size: 27rpx; color: #6B7280; line-height: 2; margin-top: 22rpx; background: #FFF; border-radius: 20rpx; padding: 26rpx; text-align: left; }
.ob-btn2 { margin-top: 22rpx; }

/* ---------- 搜索 ---------- */
.search { position: relative; margin-bottom: 20rpx; }
.search-ico { position: absolute; left: 26rpx; top: 50%; transform: translateY(-50%);
              font-size: 26rpx; opacity: .5; z-index: 1; }
.search-input { background: linear-gradient(180deg, #FFFFFF 0%, var(--brand-soft) 100%); border-radius: 999rpx; padding: 20rpx 60rpx 20rpx 68rpx;
                font-size: 27rpx; box-shadow: 0 4rpx 18rpx rgba(31,36,48,.06); }
.search-clear { position: absolute; right: 26rpx; top: 50%; transform: translateY(-50%); color: #B4BAC8; font-size: 40rpx; line-height: 1; }
.ph { color: #B4BAC8; }

/* ---------- 列表 ---------- */
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cat-tag { display: inline-block; margin-top: 8rpx; padding: 2rpx 14rpx; background: var(--brand-soft); color: var(--brand); font-size: 21rpx; border-radius: 16rpx; }
.preview { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.no-content { margin-top: 12rpx; }
.meta { margin-top: 10rpx; }

/* 掌握度色条：一眼看出这张卡处在哪个阶段 */
.note { position: relative; overflow: hidden; padding-left: 36rpx; }
.note::before {
  content: ""; position: absolute; left: 0; top: 24rpx; bottom: 24rpx;
  width: 8rpx; border-radius: 0 8rpx 8rpx 0; background: #E4E8F0;
}
.note.lv-new::before      { background: #C7CEDB; }
.note.lv-learning::before { background: linear-gradient(180deg, #6C8FF7, #3B6FF5); }
.note.lv-mastered::before { background: linear-gradient(180deg, #4FD1A5, #22B573); }

.fab {
  position: fixed; right: 40rpx;
  /* ⚠️ 必须加底部安全区：原生 tabBar 高 = 50px + 安全区，
     全面屏手机上不加这段，加号会被压在 tabBar 底下，点了等于点 tabBar */
  bottom: 140rpx;
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #FFF; font-size: 58rpx; line-height: 104rpx; text-align: center;
  z-index: 20;
}
