/* ===== 本页主题色（覆盖 app.wxss 默认值） ===== */
page {
  --brand: #E07B0A;
  --brand-2: #FBBF24;
  --brand-soft: #FFF3E4;
  --brand-ghost: rgba(224, 123, 10, .10);
  --brand-glow: rgba(224, 123, 10, .28);
  --bg-1: #FFFAF3;
  --bg-2: #FDF2E5;
  --card-2: #FFFDFA;
}

/* pages/stats/stats.wxss */
.cat-bar { display: flex; align-items: center;
  background: linear-gradient(135deg, #FFFFFF 0%, var(--brand-soft) 100%); border-radius: 999rpx;
  padding: 18rpx 22rpx 18rpx 26rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 18rpx rgba(31,36,48,.06); }
.cat-bar-label { font-size: 23rpx; color: #9AA0AC; margin-right: 14rpx; }
.cat-bar-value { flex: 1; font-size: 29rpx; font-weight: 600; color: var(--brand);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cat-bar-go { font-size: 25rpx; color: var(--brand); flex-shrink: 0; }

/* ---------- KPI 四宫格 ---------- */
.kpis { display: flex; flex-wrap: wrap; gap: 16rpx; }
.kpi {
  width: calc(50% - 8rpx); box-sizing: border-box;
  padding: 22rpx 20rpx; border-radius: 18rpx; text-align: left;
  background: #F7F9FD; border: 2rpx solid #EEF1F8;
}
.kpi:nth-child(1) { background: var(--brand-soft); border-color: var(--brand-soft); }
.kpi:nth-child(2) { background: #FFEDEE; border-color: #FFDCDD; }
.kpi:nth-child(3) { background: #FFF3E4; border-color: #FFE6CC; }
.kpi:nth-child(4) { background: #E7F7F0; border-color: #D3F0E4; }
.kpi-num { font-size: 44rpx; font-weight: 800; line-height: 1.25; color: var(--brand);
           font-variant-numeric: tabular-nums; animation: tick .5s cubic-bezier(.2,.9,.3,1.4) both; }
.kpi:nth-child(2) .kpi-num { color: #FF5A5F; }
.kpi:nth-child(3) .kpi-num { color: #F0851F; }
.kpi:nth-child(4) .kpi-num { color: #22B573; }

/* ---------- 学习热力图（可读版） ---------- */
.heat-box {
  margin-top: 22rpx; padding: 18rpx 20rpx 14rpx;
  background: #FAFBFE; border-radius: 16rpx;
}
.heat-months { position: relative; height: 26rpx; margin-left: 34rpx; }
.heat-month {
  position: absolute; top: 0; font-size: 20rpx; color: #9AA0AC; white-space: nowrap;
}

.heat-body { position: relative; display: flex; margin-top: 6rpx; }
.heat-days { position: relative; width: 34rpx; flex-shrink: 0; }
.heat-day {
  position: absolute; left: 0; font-size: 20rpx; color: #9AA0AC;
  line-height: 26rpx; height: 26rpx;
}

.heat { display: flex; gap: 8rpx; }
.heat-col { display: flex; flex-direction: column; gap: 8rpx; }
.heat-cell {
  width: 26rpx; height: 26rpx; border-radius: 7rpx; box-sizing: border-box;
  transition: transform .12s ease;
}
.lv0 { background: #EEF0F6; }
.lv1 { background: #BBD0FA; }
.lv2 { background: #6C8FF7; }
.lv3 { background: linear-gradient(135deg, #6C8FF7, #3B6FF5); }
/* 还没到的日子：虚线空框，和"学习了但没记录"彻底区分开 */
.lv-1 { background: transparent; border: 2rpx dashed #DFE4EE; }

/* 今天：加一圈主题色描边 */
.heat-cell.today { box-shadow: 0 0 0 3rpx var(--brand); }
/* 选中的那一格：橙色描边 + 放大一点 */
.heat-cell.picked { box-shadow: 0 0 0 3rpx #F0851F; transform: scale(1.16); }

/* 点击后的读数 */
.heat-read {
  margin-top: 16rpx; text-align: center; font-size: 25rpx; color: #4A5266;
  background: #F5F7FC; border-radius: 12rpx; padding: 14rpx 18rpx;
}
.heat-read.idle { color: #9AA0AC; font-size: 23rpx; background: transparent; }
.hr-date { font-weight: 700; margin-right: 12rpx; color: #3A4256; }
.hr-val { color: var(--brand); font-weight: 600; }
.hr-val.none { color: #9AA0AC; font-weight: 400; }

/* 图例：给出具体数值 */
.heat-legend { display: flex; gap: 22rpx; margin-top: 16rpx; flex-wrap: wrap; }
.hl-item { display: flex; align-items: center; font-size: 21rpx; color: #8A90A0; }
.hl-item .heat-cell { width: 22rpx; height: 22rpx; border-radius: 6rpx; margin-right: 8rpx; }

/* 一句话总结 */
.heat-sum {
  margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #F1F3F8;
  font-size: 24rpx; color: #6B7280; line-height: 1.7;
}
.hs-n { font-weight: 800; color: var(--brand); font-size: 28rpx; }

/* ---------- 难点榜 ---------- */
.hard-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #F1F3F8; }
.hard-item:last-child { border-bottom: none; }
.hard-left { flex: 1; margin-right: 20rpx; min-width: 0; }
.hard-title { font-size: 28rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hard-bar { width: 140rpx; height: 14rpx; background: #F1F3F8; border-radius: 999rpx; overflow: hidden; }
.hard-fill {
  height: 100%; border-radius: 999rpx; background: linear-gradient(90deg,#FF8A8E,#FF5A5F);
  animation: grow .6s cubic-bezier(.2,.9,.3,1) both; transform-origin: left center;
}

.mt { margin-top: 24rpx; }
.mt-s { margin-top: 14rpx; }

/* 引导入口 */
.tour-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #F1F3F8; }
.tour-item:last-child { border-bottom: none; }
.tour-icon { font-size: 36rpx; width: 56rpx; }
.tour-body { flex: 1; }
.tour-name { font-size: 29rpx; font-weight: 600; }
.tour-go { font-size: 25rpx; color: var(--brand); }

/* ==================== AI 学习诊断 ==================== */
.btn-ai {
  background-image: linear-gradient(135deg, #7C5BD9 0%, #5B6EF5 100%);
  color: #FFF; border-radius: 44rpx; font-size: 29rpx; font-weight: 600;
  line-height: 88rpx; text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(91,110,245,.30);
  transition: opacity .12s, transform .12s;
}
.advice-box {
  margin-top: 18rpx; border-radius: 14rpx; padding: 20rpx 22rpx;
  background-image: linear-gradient(135deg, #F4F5FF 0%, #EEF0FF 100%);
  border-left: 6rpx solid #5B6EF5;
  animation: cardIn .28s ease both;
}
.advice-box.loading {
  display: flex; align-items: center;
  font-size: 23rpx; color: #5B6EF5;
}
.advice-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%; background: #5B6EF5;
  margin-right: 14rpx; flex-shrink: 0;
  animation: aiPulse 1s ease-in-out infinite;
}
@keyframes aiPulse { 0%,100% { opacity: .35; transform: scale(.8) } 50% { opacity: 1; transform: scale(1.15) } }
.advice-badge {
  display: inline-block; font-size: 20rpx; font-weight: 700; color: #FFF;
  background-image: linear-gradient(135deg, #7C5BD9, #5B6EF5);
  border-radius: 999rpx; padding: 4rpx 14rpx; margin-bottom: 12rpx;
}
.advice-text { font-size: 26rpx; color: #3A4256; line-height: 1.75; }
.advice-note { display: block; margin-top: 12rpx; text-align: center; font-size: 21rpx; }

/* ==================== hero：和产品介绍同一套视觉语言 ====================
 * 深墨蓝打底 + 右上暖光 + 左下青绿光 + 一层极淡斜纹（.hero::after）
 * 不再是一整片纯色渐变 —— 那正是「很 AI」的来源
 */
.hero {
  position: relative; overflow: hidden;
  border-radius: 24rpx; padding: 30rpx 28rpx 26rpx; margin-bottom: 20rpx;
  background: var(--hero-grad);
  box-shadow: var(--hero-shadow);
}
.hero::after {
  content: ""; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background-image: repeating-linear-gradient(58deg, rgba(255,255,255,.055) 0 1rpx, rgba(255,255,255,0) 1rpx 26rpx);
  pointer-events: none;
}
.hero-row { position: relative; display: flex; align-items: baseline; }
.hero-big { font-size: 76rpx; font-weight: 800; color: #FFF; line-height: 1; letter-spacing: -1rpx; }
.hero-unit { font-size: 24rpx; color: rgba(255,255,255,.75); margin-left: 10rpx; }
.hero-side { margin-left: auto; text-align: right; }
.hero-line { font-size: 22rpx; color: rgba(255,255,255,.78); line-height: 1.7; }
.hero-em { color: #FFD79A; font-weight: 700; }

.hero-nums { position: relative; display: flex; margin-top: 22rpx; }
.hn { flex: 1; text-align: center; }
.hn-n { font-size: 34rpx; font-weight: 700; color: #FFF; }
.hn-l { font-size: 21rpx; color: rgba(255,255,255,.66); margin-top: 2rpx; }

.mbar { position: relative; display: flex; height: 16rpx; border-radius: 8rpx; overflow: hidden; margin-top: 22rpx; background: rgba(255,255,255,.14); }
.mb-seg { height: 100%; }
.mb-seg.mastered { background: #4FD1A5; }
.mb-seg.learning { background: #6C8FF7; }
.mb-seg.fresh { background: rgba(255,255,255,.28); }
.mbar-legend { position: relative; display: flex; gap: 20rpx; margin-top: 12rpx; flex-wrap: wrap; }
.ml { font-size: 20rpx; color: rgba(255,255,255,.72); }

/* ==================== 分段控件（模式切换用） ==================== */
.seg { display: flex; background: #F2F5FB; border-radius: 999rpx; padding: 5rpx; }
.seg-i {
  padding: 10rpx 24rpx; font-size: 23rpx; color: #6B7280; border-radius: 999rpx;
  transition: background .16s ease, color .16s ease;
}
.seg-i.on { background: #FFF; color: #2C4FD8; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(31,36,48,.10); }
.seg-wide { margin-top: 14rpx; }
.seg-wide .seg-i { flex: 1; text-align: center; padding: 14rpx 0; }

/* ==================== 学习日历 ==================== */
.cal-ops { display: flex; align-items: center; gap: 14rpx; margin: 14rpx 0 6rpx; flex-wrap: wrap; }
.years { display: flex; gap: 10rpx; }
.year-chip {
  font-size: 22rpx; color: #5A6072; padding: 8rpx 18rpx; border-radius: 999rpx; background: #F2F5FB;
}
.year-chip.on { background: #2C4FD8; color: #FFF; font-weight: 600; }

.cal-x { width: 100%; white-space: nowrap; }
.cal { display: inline-block; padding: 4rpx 0 2rpx; }
.cal-months { position: relative; height: 30rpx; }
.cal-month { position: absolute; top: 0; font-size: 19rpx; color: #98A0AE; }
.cal-body { display: flex; }
.cal-days { position: relative; width: 34rpx; flex-shrink: 0; }
.cal-day { position: absolute; left: 0; font-size: 19rpx; color: #98A0AE; }
.cal-grid { display: flex; gap: 10rpx; }
.cal-col { display: flex; flex-direction: column; gap: 10rpx; }
.cal-cell { border-radius: 8rpx; box-sizing: border-box; transition: transform .12s ease; }
.cal-cell.lv0 { background: #EDF0F7; }
.cal-cell.lv1 { background: #C3D6FB; }
.cal-cell.lv2 { background: #8FAEF8; }
.cal-cell.lv3 { background: #5C84F5; }
.cal-cell.lv4 { background: linear-gradient(135deg, #6C8FF7, #2C4FD8); }
.cal-cell.lv-1 { background: transparent; border: 2rpx dashed #E2E7F1; }
.cal-cell.today { box-shadow: 0 0 0 3rpx var(--brand); }
.cal-cell.picked { box-shadow: 0 0 0 3rpx #F0851F; transform: scale(1.18); }

.cal-read {
  margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx;
  background: #F5F7FB; font-size: 23rpx; color: #454B5A; line-height: 1.6;
}
.cal-read.idle { color: #9AA0AC; background: transparent; font-size: 22rpx; }
.cr-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10rpx; }
.cr-date { font-weight: 700; color: #1F2430; }
.cr-val { color: #3B6FF5; }
.cr-val.none { color: #9AA0AC; }
.cr-notes { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; }
.cr-note { font-size: 22rpx; color: #5A6072; background: #FFF; padding: 6rpx 14rpx; border-radius: 999rpx; }

.cal-legend { display: flex; gap: 18rpx; margin-top: 16rpx; flex-wrap: wrap; align-items: center; }
.cl-i { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: #8A90A0; }
.cal-sum { margin-top: 14rpx; font-size: 22rpx; color: #6B7280; line-height: 1.7; }
.hs-n { color: #2C4FD8; font-weight: 700; }

/* ==================== 接下来 7 天 ==================== */
.fc { display: flex; align-items: flex-end; gap: 8rpx; margin-top: 18rpx; }
.fc-col { flex: 1; text-align: center; }
.fc-n { font-size: 24rpx; font-weight: 700; color: #2C4FD8; }
.fc-n.zero { color: #C2CAD8; }
.fc-bar-wrap { display: flex; align-items: flex-end; justify-content: center; height: 90rpx; margin: 8rpx 0; }
.fc-bar { width: 100%; max-width: 40rpx; border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #6C8FF7, #3B6FF5); }
.fc-l { font-size: 19rpx; color: #98A0AE; }

/* ==================== 本周 vs 上周 ==================== */
.wk { display: flex; align-items: center; margin-top: 16rpx; }
.wk-box { flex: 1; text-align: center; padding: 18rpx 0; background: #F7F9FD; border-radius: 16rpx; }
.wk-n { font-size: 44rpx; font-weight: 800; color: #1F2430; line-height: 1.1; }
.wk-acc { font-size: 21rpx; color: #6B7280; margin-top: 6rpx; }
.wk-mid { width: 130rpx; text-align: center; }
.wk-d { font-size: 30rpx; font-weight: 700; color: #9AA0AC; }
.wk-mid.up .wk-d { color: #22B573; }
.wk-mid.down .wk-d { color: #F0851F; }
.wk-dl { font-size: 19rpx; color: #A8AEBC; }

/* ==================== 时段分布 ==================== */
.hrs { display: flex; align-items: flex-end; gap: 5rpx; height: 70rpx; margin-top: 14rpx; }
.hr { flex: 1; display: flex; align-items: flex-end; height: 100%; }
.hr-bar { width: 100%; border-radius: 4rpx; background: #D9E3FB; }
.hr-bar.peak { background: linear-gradient(180deg, #FFC46B, #F0851F); }
.hrs-x { display: flex; justify-content: space-between; margin-top: 6rpx; font-size: 19rpx; color: #A8AEBC; }

/* ==================== 类别排行 ==================== */
.ct { margin-top: 16rpx; }
.ct-top { display: flex; align-items: baseline; }
.ct-name { flex: 1; min-width: 0; font-size: 25rpx; font-weight: 600;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ct-n { font-size: 21rpx; color: #8A90A0; margin-left: 10rpx; }
.ct-track { height: 14rpx; background: #EDF0F7; border-radius: 8rpx; margin-top: 10rpx; overflow: hidden; }
.ct-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #4FD1A5, #22B573); }

/* ==================== 设置行 ==================== */
.set-row { margin-top: 6rpx; }
.set-t { font-size: 27rpx; font-weight: 600; color: #1F2430; margin-bottom: 4rpx; }
