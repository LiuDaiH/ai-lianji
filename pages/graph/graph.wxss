/* pages/graph/graph.wxss */
/* 图谱不是 tab 页，没有 tabBar 占位，用 100vh 正好 */
page { height: 100%; overflow: hidden; }
.container { padding: 20rpx 24rpx; height: 100vh; box-sizing: border-box;
  display: flex; flex-direction: column; }

.head { padding: 6rpx 6rpx 16rpx; }
.h-row { display: flex; align-items: center; justify-content: space-between; }
.h-title { font-size: 38rpx; font-weight: 700; }
.h-help {
  font-size: 22rpx; color: #3B6FF5; padding: 8rpx 18rpx;
  background: #EAF1FE; border-radius: 999rpx; flex-shrink: 0;
}
.h-sub { font-size: 23rpx; color: #8A90A0; margin-top: 6rpx; line-height: 1.6; }
.h-stats { margin-top: 14rpx; display: flex; align-items: baseline; }
.hs-n { font-size: 30rpx; font-weight: 700; color: #3B6FF5; }
.hs-l { font-size: 22rpx; color: #8A90A0; margin-left: 4rpx; }
.hs-sep { color: #D5DAE5; margin: 0 14rpx; }
.h-warn {
  margin-top: 12rpx; padding: 12rpx 16rpx; border-radius: 12rpx;
  background: #FFF7E8; color: #B7791F; font-size: 21rpx; line-height: 1.6;
}

.tools { display: flex; gap: 10rpx; margin-bottom: 14rpx; }
.tool {
  flex: 1; text-align: center; font-size: 22rpx; color: #5A6072;
  padding: 14rpx 4rpx; background: #FFF; border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(31,36,48,.05);
  box-sizing: border-box;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.tool.on { background: #3B6FF5; color: #FFF; font-weight: 600; }

.cv-wrap {
  position: relative; flex: 1; min-height: 0;
  background: #FBFCFE; border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31,36,48,.05);
}
.cv { width: 100%; height: 100%; }
.empty {
  position: absolute; left: 0; right: 0; top: 42%;
  text-align: center; color: #A8AEBC; font-size: 26rpx;
}

/* ---------- 画布上的浮层 ---------- */
.zoom-chip {
  position: absolute; left: 14rpx; bottom: 14rpx;
  padding: 6rpx 14rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.86); color: #8A90A0;
  font-size: 19rpx; font-variant-numeric: tabular-nums;
  box-shadow: 0 2rpx 8rpx rgba(31,36,48,.07);
}

.zoomers { position: absolute; right: 14rpx; bottom: 14rpx;
  display: flex; flex-direction: column; gap: 10rpx; }
.zbtn {
  width: 64rpx; height: 64rpx; line-height: 62rpx; text-align: center;
  border-radius: 50%; background: rgba(255,255,255,.94); color: #3B6FF5;
  font-size: 34rpx; font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(31,36,48,.14);
}

.focus-chip {
  position: absolute; left: 14rpx; top: 14rpx;
  display: flex; align-items: center;
  padding: 8rpx 16rpx; border-radius: 999rpx;
  background: rgba(43,58,85,.92); color: #FFF; font-size: 21rpx;
  box-shadow: 0 4rpx 14rpx rgba(31,36,48,.18);
}
.fc-x { margin-left: 12rpx; font-size: 21rpx; opacity: .8; }

.legend {
  display: flex; align-items: center; flex-wrap: wrap; gap: 20rpx;
  padding: 16rpx 6rpx 4rpx; font-size: 22rpx; color: #6B7280;
}
.lg { display: flex; align-items: center; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 8rpx; }
.line { width: 28rpx; height: 0; margin-right: 8rpx; border-top-width: 3rpx; border-top-style: solid; }
.line.solid { border-top-color: rgba(59,111,245,.75); }
.line.dash { border-top-style: dashed; border-top-color: rgba(150,160,180,.9); }

/* ---------- 底部抽屉 ---------- */
.sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15,20,30,.28); z-index: 20;
  animation: maskIn .2s ease both;
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }

.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 21;
  background: #FFF; border-radius: 28rpx 28rpx 0 0;
  padding: 14rpx 26rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(31,36,48,.16);
  animation: sheetUp .26s cubic-bezier(.2,.9,.3,1.05) both;
}
@keyframes sheetUp {
  from { transform: translateY(100%); opacity: .4; }
  to   { transform: translateY(0);     opacity: 1; }
}

.sh-grip { width: 68rpx; height: 8rpx; border-radius: 4rpx;
  background: #E3E7EF; margin: 4rpx auto 16rpx; }
.sh-head { padding-bottom: 14rpx; }
.sh-title { font-size: 32rpx; font-weight: 700;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sh-sub { font-size: 22rpx; color: #8A90A0; margin-top: 6rpx; }

.sh-ops { display: flex; gap: 14rpx; padding-bottom: 16rpx; }
.sh-btn {
  flex: 1; text-align: center; font-size: 25rpx; line-height: 68rpx;
  border-radius: 34rpx; background: #F2F5FB; color: #3B6FF5; font-weight: 600;
}
.sh-btn.primary { background: #3B6FF5; color: #FFF; line-height: 78rpx; font-size: 27rpx; }
.sh-btn.primary:active { opacity: .85; }
.sh-btn.ghost { background: #F7F8FB; color: #6B7280; font-weight: 500; flex: 0 0 130rpx; }

.sh-list { box-sizing: border-box; }
.sh-item {
  display: flex; align-items: center; padding: 14rpx 4rpx;
  border-bottom: 1rpx solid #F4F6FA;
}
.sh-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.sh-dot.new { background: #C2CAD8; }
.sh-dot.learning { background: #3B6FF5; }
.sh-dot.mastered { background: #34A853; }
.sh-body { flex: 1; min-width: 0; }
.sh-name { font-size: 27rpx; font-weight: 600;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sh-meta { font-size: 21rpx; color: #8A90A0; margin-top: 2rpx; }
.sh-go { color: #C2CAD8; font-size: 30rpx; margin-left: 12rpx; flex-shrink: 0; }

.sh-none { text-align: center; color: #A8AEBC; font-size: 24rpx; padding: 34rpx 0; }
.sh-more { text-align: center; color: #A8AEBC; font-size: 21rpx; padding: 16rpx 0 6rpx; }
