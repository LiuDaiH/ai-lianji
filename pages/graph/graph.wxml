<!-- pages/graph/graph.wxml -->
<page-meta page-style="{{pageStyle}}"></page-meta>

<view class="container">

  <view class="head">
    <view class="h-row">
      <view class="h-title">知识图谱</view>
      <view class="h-ops">
        <view class="h-help" bindtap="onOpenSearch" hover-class="hover-dim">🔍 搜索</view>
        <view class="h-help" bindtap="onRestartTour" hover-class="hover-dim">? 怎么用</view>
      </view>
    </view>
    <view class="h-stats">
      <text class="hs-n">{{stats.notes}}</text><text class="hs-l">卡片</text>
      <text class="hs-sep">·</text>
      <text class="hs-n">{{stats.cats}}</text><text class="hs-l">类别</text>
      <text class="hs-sep">·</text>
      <text class="hs-n">{{stats.links}}</text><text class="hs-l">条关联</text>
    </view>
    <view class="h-warn" wx:if="{{trimmed > 0}}">
      图上只画了 {{shown}} 张（点类别看全部）
    </view>
  </view>

  <view class="tools" id="gtools">
    <view class="tool {{onlyLinked ? 'on' : ''}}" bindtap="onToggleFilter" hover-class="hover-dim">
      {{onlyLinked ? '只看关联' : '显示全部'}}
    </view>
    <view class="tool {{canUndo ? 'warn' : ''}}" bindtap="{{canUndo ? 'onUndoLayout' : 'onRelayout'}}"
          hover-class="hover-dim">{{canUndo ? '↩ 撤销' : '重排'}}</view>
    <view class="tool" bindtap="onFit" hover-class="hover-dim">适配</view>
    <view class="tool {{focus ? 'on' : ''}}" bindtap="onFocusTool" hover-class="hover-dim">◎ 聚焦</view>
  </view>

  <view class="cv-wrap">
    <canvas type="2d" id="gcv" class="cv"
            bindtouchstart="onTouchStart"
            bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd"
            bindtouchcancel="onTouchEnd"></canvas>

    <!-- 缩放档位：让"为什么有些字看不见"有个交代 -->
    <view class="zoom-chip">{{zoomPct}}% · {{labelText}}</view>

    <view class="zoomers" id="gzoom">
      <view class="zbtn" data-d="in" bindtap="onZoom" hover-class="hover-dim">＋</view>
      <view class="zbtn" data-d="out" bindtap="onZoom" hover-class="hover-dim">−</view>
    </view>

    <view class="focus-chip" wx:if="{{focus}}" bindtap="onClearFocus" hover-class="hover-dim">
      聚焦：{{focus.title}}<text class="fc-x">✕ 退出</text>
    </view>

    <view class="empty" wx:if="{{empty}}">还没有卡片，先去录入几张</view>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="lg" wx:for="{{legend}}" wx:key="label">
      <view class="dot" style="background:{{item.color}}"></view>
      <text>{{item.label}}</text>
    </view>
    <view class="lg"><view class="line solid"></view><text>有关联</text></view>
    <view class="lg"><view class="line dash"></view><text>父子</text></view>
  </view>

  <!-- ============ 底部抽屉：点类别就看它下面有哪些卡片 ============ -->
  <view class="sheet-mask" wx:if="{{sheet.show}}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{sheet.show}}">
    <view class="sh-grip"></view>
    <view class="sh-head">
      <view class="sh-title">{{sheet.title}}</view>
      <view class="sh-sub">{{sheet.sub}}</view>
    </view>

    <view class="sh-ops">
      <view class="sh-btn primary" wx:if="{{sheet.kind === 'cat'}}" bindtap="onToggleFocus" hover-class="hover-dim">
        {{sheet.focusOn ? '✕ 退出聚焦' : '◎ 只看这一块'}}
      </view>
      <view class="sh-btn ghost" bindtap="closeSheet" hover-class="hover-dim">收起</view>
    </view>

    <scroll-view scroll-y class="sh-list" style="height:{{sheet.listH}}px">
      <view class="sh-item" wx:for="{{sheet.items}}" wx:key="id" data-id="{{item.id}}"
            bindtap="onGoItem" hover-class="hover-dim">
        <view class="sh-dot {{item.level}}"></view>
        <view class="sh-body">
          <view class="sh-name">{{item.title}}</view>
          <view class="sh-meta">{{item.meta}}</view>
        </view>
        <view class="sh-go">›</view>
      </view>
      <view class="sh-none" wx:if="{{!sheet.items.length}}">
        {{sheet.kind === 'catpick' ? '还没有类别' : '这里还没有卡片'}}
      </view>
      <view class="sh-more" wx:if="{{sheet.more > 0}}">⋯ 还有 {{sheet.more}} 张没列出</view>
    </scroll-view>
  </view>

  <!-- ============ 全屏搜索：一个框，类别和卡片一起搜 ============ -->
  <view class="sp" wx:if="{{search.show}}">
    <view class="sp-bar">
      <input class="sp-input" value="{{search.kw}}" bindinput="onSearchInput" focus="{{search.show}}"
             confirm-type="search" placeholder="搜类别或卡片，比如「过拟合」「神经网络」"
             placeholder-class="sp-ph" />
      <view class="sp-cancel" bindtap="onCloseSearch" hover-class="hover-dim">取消</view>
    </view>

    <scroll-view scroll-y class="sp-body">
      <block wx:if="{{search.cats.length}}">
        <view class="sp-sec">类别 · {{search.catTotal}}</view>
        <view class="sp-row" wx:for="{{search.cats}}" wx:key="id" data-id="{{item.id}}"
              bindtap="onPickSearchCat" hover-class="hover-dim">
          <view class="sp-catdot"></view>
          <view class="sp-col">
            <view class="sp-name">{{item.name}}</view>
            <view class="sp-sub">{{item.path}} · {{item.count}} 张</view>
          </view>
          <view class="sp-act">只看这块 ›</view>
        </view>
        <view class="sp-more" wx:if="{{search.catMore > 0}}">…还有 {{search.catMore}} 个类别</view>
      </block>

      <block wx:if="{{search.notes.length}}">
        <view class="sp-sec">卡片 · {{search.noteTotal}}</view>
        <view class="sp-row" wx:for="{{search.notes}}" wx:key="id" data-id="{{item.id}}"
              bindtap="onPickSearchNote" hover-class="hover-dim">
          <view class="sh-dot {{item.level}}"></view>
          <view class="sp-col">
            <view class="sp-name">{{item.title}}</view>
            <view class="sp-sub">{{item.meta}}</view>
          </view>
          <view class="sp-act">定位 ›</view>
        </view>
        <view class="sp-more" wx:if="{{search.noteMore > 0}}">…还有 {{search.noteMore}} 张卡片</view>
      </block>

      <view class="sp-none" wx:if="{{!search.cats.length && !search.notes.length}}">没有匹配的类别或卡片</view>
    </scroll-view>
  </view>

  <coach id="coach" flow="{{tourFlow}}" active="{{tourActive}}"
         bind:close="onTourClose" bind:lock="onTourLock" />

</view>
