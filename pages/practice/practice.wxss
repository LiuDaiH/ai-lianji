/* ===== 本页主题色（覆盖 app.wxss 默认值） ===== */
page {
  --brand: #7C5BD9;
  --brand-2: #A78BFA;
  --brand-soft: #F1ECFE;
  --brand-ghost: rgba(124, 91, 217, .10);
  --brand-glow: rgba(124, 91, 217, .28);
  --bg-1: #F7F5FF;
  --bg-2: #EFEDFA;
  --card-2: #FDFCFF;
}

/* pages/practice/practice.wxss */
.hero {
  background: linear-gradient(135deg, #5B4BD6 0%, #8B7BF0 100%);
  border-radius: 24rpx; padding: 40rpx 32rpx; color: #FFF; margin-bottom: 22rpx;
  animation: fadeUp .36s cubic-bezier(.2,.9,.3,1.1) both;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: .88; margin-top: 10rpx; line-height: 1.6; }

.cat-bar { display: flex; align-items: center; background: #FFF; border-radius: 18rpx;
  padding: 22rpx 26rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(31,36,48,.05); }
.cat-bar-label { font-size: 23rpx; color: #9AA0AC; margin-right: 14rpx; }
.cat-bar-value { flex: 1; font-size: 29rpx; font-weight: 600; color: #5B4BD6;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cat-bar-go { font-size: 25rpx; color: #5B4BD6; flex-shrink: 0; }

.row-between { display: flex; align-items: center; justify-content: space-between; }
.link { font-size: 25rpx; color: #5B4BD6; }

/* 题型选择 */
.modes { margin-top: 20rpx; }
.mode {
  display: flex; align-items: center; padding: 18rpx 20rpx;
  background: #F7F8FC; border-radius: 16rpx; margin-bottom: 14rpx;
  border: 2rpx solid transparent; transition: all .16s;
}
.mode.on { background: #F0EDFF; border-color: #5B4BD6; }
.mode.off { opacity: .45; }
.mode-check {
  width: 38rpx; height: 38rpx; line-height: 38rpx; text-align: center;
  border-radius: 50%; border: 3rpx solid #D5DAE5; margin-right: 20rpx;
  flex-shrink: 0; font-size: 24rpx; color: #FFF; box-sizing: border-box;
  transition: all .16s;
}
.mode.on .mode-check { background: #5B4BD6; border-color: #5B4BD6; }
.mode-body { flex: 1; }
.mode-name { font-size: 28rpx; font-weight: 600; }
.mode-desc { font-size: 22rpx; color: #8A90A0; margin-top: 2rpx; }

.sizes { display: flex; gap: 14rpx; margin-top: 18rpx; }
.size { flex: 1; text-align: center; font-size: 26rpx; color: #6B7280;
  padding: 16rpx 0; background: #F2F4F9; border-radius: 16rpx; transition: all .16s; }
.size.on { background: #5B4BD6; color: #FFF; font-weight: 600; }

.info { margin-top: 20rpx; }
.num { color: #5B4BD6; font-weight: 700; }
.hot { color: #FF5A5F; font-weight: 700; }
.start { margin-top: 24rpx; background: #5B4BD6; }
.mt-s { margin-top: 14rpx; }

.kpis { display: flex; }
.kpi { flex: 1; text-align: center; }
.kpi-num { font-size: 40rpx; font-weight: 700; color: #5B4BD6; line-height: 1.3; }

.h-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #F1F3F8; }
.h-item:last-child { border-bottom: none; }
.h-day { font-size: 24rpx; color: #8A90A0; width: 76rpx; }
.h-scope { flex: 1; font-size: 24rpx; color: #4A5062;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
.h-bar { width: 140rpx; height: 12rpx; background: #F1F3F8; border-radius: 8rpx; }
.h-fill { height: 100%; border-radius: 8rpx; }
.h-fill.good { background: #34A853; }
.h-fill.mid  { background: #E8A33D; }
.h-fill.low  { background: #FF5A5F; }
.h-rate { width: 96rpx; text-align: right; font-size: 24rpx; font-weight: 600; color: #4A5062; }
